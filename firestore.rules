rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper Functions ----

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().roleSlug == 'super_admin';
    }

    function isAdmin() {
      return isSignedIn() && (getUserData().roleSlug == 'admin' || getUserData().roleSlug == 'super_admin');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- Collection Rules ----

    // D1: users
    match /users/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || isAdmin());
      allow create: if isSignedIn(); // signup creates own profile post-auth
      allow update: if isSuperAdmin()
        || (isAdmin() && resource.data.roleSlug != 'super_admin')
        || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'updatedAt']));
    }

    // D2: roles
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // D3: features
    match /features/{featureId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // D4: invitations
    // Signup reads the invitation BEFORE the user account exists, so this
    // lookup must work unauthenticated. The previous version of this rule
    // required isSignedIn() and would have broken the signup flow.
    //
    // KNOWN WEAKNESS, accepted deliberately: this permits anonymous
    // one-doc-at-a-time reads, so invitation tokens remain enumerable. It is
    // scoped as tightly as security rules allow while keeping signup working.
    // The durable fix is a server-side token exchange against a hashed token.
    match /invitations/{invId} {
      allow read: if request.query.limit == 1 || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt']));
    }

    // D5: activity_logs
    match /activity_logs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
    }

    // D6: system_settings
    match /system_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ---- Reddit Visibility ----
    // Projects are shared across all users with feature access.
    // Gate on isSignedIn(); client-side hasFeatureAccess() guards the UI.

    match /reddit_projects/{projectId} {
      allow read, write: if isSignedIn();
    }
    match /reddit_sources/{sourceId} {
      allow read, write: if isSignedIn();
    }
    match /reddit_posts/{postId} {
      allow read, write: if isSignedIn();
    }
    match /reddit_opportunity_analyses/{analysisId} {
      allow read, write: if isSignedIn();
    }
    match /reddit_drafts/{draftId} {
      allow read, write: if isSignedIn();
    }

    // The posting queue and its supporting collections. These were missing
    // from this file entirely: deploying it as it stood would have denied all
    // access to them by default and broken the Accounts page and auto-posting.
    //
    // The posting agent uses the Admin SDK and bypasses rules, so these cover
    // the web app only. reddit_agent_status is read-only here because the
    // agent is its sole writer.

    match /reddit_accounts/{accountId} {
      allow read, write: if isSignedIn();
    }
    match /reddit_post_jobs/{jobId} {
      allow read, write: if isSignedIn();
    }
    match /reddit_agent_status/{docId} {
      allow read: if isSignedIn();
    }
  }
}
